generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum GoalStatus {
  DRAFT
  ACTIVE
  COMPLETED
}

enum ResourceType {
  ARTICLE
  VIDEO
  COURSE
  NOTE
  TOOL
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum CalendarProvider {
  GOOGLE_CALENDAR
}

enum LearnerContextStatus {
  DRAFT
  NEEDS_FOLLOW_UP
  READY
}

enum FollowUpStatus {
  OPEN
  ANSWERED
  DISMISSED
}

enum RoadmapVersionSource {
  AGENT_GENERATED
  REGENERATED
  USER_EDITED
}

enum CalendarEventStatus {
  NOT_SCHEDULED
  SCHEDULED
  SYNC_ERROR
}

enum ResourceProgressStatus {
  SAVED
  COMPLETED
}

model User {
  id                String            @id @default(cuid())
  email             String            @unique
  fullName          String
  passwordHash      String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  studentProfile    StudentProfile?
  learnerContext    LearnerContext?
  followUpQuestions FollowUpQuestion[]
  goals             Goal[]
  roadmapItems      RoadmapItem[]
  roadmapVersions   RoadmapVersion[]
  roadmapTasks      RoadmapTask[]
  resources         Resource[]
  calendarSync      CalendarSync?
  googleCalendarToken GoogleCalendarToken?
  taskResources     TaskResource[]
  performanceSnapshots PerformanceSnapshot[]
  practiceTests     PracticeTest[]
  practiceTestAttempts PracticeTestAttempt[]
  progressEntries   ProgressEntry[]
}

model StudentProfile {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  currentSubjectTopic    String
  targetGoal             String
  currentSkillLevel      String
  deadline               DateTime?
  availableStudyTime     String
  preferredLearningStyle String
  constraints            String?
  weakAreas              String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Goal {
  id          String     @id @default(cuid())
  userId      String
  title       String
  description String?
  status      GoalStatus @default(DRAFT)
  targetDate  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RoadmapItem {
  id          String         @id @default(cuid())
  userId      String
  title       String
  description String?
  status      ProgressStatus @default(NOT_STARTED)
  dueDate     DateTime?
  position    Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Resource {
  id        String       @id @default(cuid())
  userId    String
  title     String
  url       String
  type      ResourceType @default(ARTICLE)
  notes     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CalendarSync {
  id                   String           @id @default(cuid())
  userId               String           @unique
  provider             CalendarProvider @default(GOOGLE_CALENDAR)
  googleEmail          String?
  isConnected          Boolean          @default(false)
  lastSyncedAt         DateTime?
  accessTokenExpiresAt DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProgressEntry {
  id          String         @id @default(cuid())
  userId      String
  label       String
  notes       String?
  status      ProgressStatus @default(NOT_STARTED)
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LearnerContext {
  id                 String               @id @default(cuid())
  userId             String               @unique
  status             LearnerContextStatus @default(DRAFT)
  summary            String?
  intent             String?
  readiness          String?
  confidenceLabel    String?
  extraNotes         String?
  normalizedJson     String
  missingInfoSummary String?
  skillGapsSummary   String?
  constraintsSummary String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  followUpQuestions  FollowUpQuestion[]
  roadmapVersions    RoadmapVersion[]
}

model FollowUpQuestion {
  id               String          @id @default(cuid())
  userId           String
  learnerContextId String?
  question         String
  rationale        String?
  status           FollowUpStatus  @default(OPEN)
  answer           String?
  createdAt        DateTime        @default(now())
  answeredAt       DateTime?
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  learnerContext   LearnerContext? @relation(fields: [learnerContextId], references: [id], onDelete: SetNull)
}

model RoadmapVersion {
  id               String               @id @default(cuid())
  userId           String
  learnerContextId String?
  versionNumber    Int
  goal             String
  summary          String?
  contentJson      String
  isActive         Boolean              @default(true)
  source           RoadmapVersionSource @default(AGENT_GENERATED)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  learnerContext   LearnerContext?      @relation(fields: [learnerContextId], references: [id], onDelete: SetNull)
  tasks            RoadmapTask[]
  performanceSnapshots PerformanceSnapshot[]
  practiceTests    PracticeTest[]
}

model RoadmapTask {
  id                String              @id @default(cuid())
  userId            String
  roadmapVersionId  String
  milestoneTitle    String
  milestoneIndex    Int
  taskIndex         Int
  title             String
  details           String
  estimatedTime     String
  priority          String
  dueWindow         String
  status            ProgressStatus      @default(NOT_STARTED)
  actualMinutes     Int?
  completedAt       DateTime?
  scheduledStart    DateTime?
  scheduledEnd      DateTime?
  calendarEventId   String?
  calendarStatus    CalendarEventStatus @default(NOT_SCHEDULED)
  syncError         String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmapVersion    RoadmapVersion      @relation(fields: [roadmapVersionId], references: [id], onDelete: Cascade)
  resources         TaskResource[]

  @@unique([roadmapVersionId, milestoneIndex, taskIndex])
}

model TaskResource {
  id            String                 @id @default(cuid())
  userId        String
  roadmapTaskId String
  title         String
  url           String
  type          ResourceType           @default(ARTICLE)
  whyRelevant   String
  status        ResourceProgressStatus @default(SAVED)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmapTask   RoadmapTask            @relation(fields: [roadmapTaskId], references: [id], onDelete: Cascade)
}

model GoogleCalendarToken {
  id                    String   @id @default(cuid())
  userId                String   @unique
  accessTokenEncrypted  String?
  refreshTokenEncrypted String
  primaryCalendarId     String?
  calendarTimezone      String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PerformanceSnapshot {
  id                     String         @id @default(cuid())
  userId                 String
  roadmapVersionId       String?
  summary                String
  onTrackStatus          String
  completionRate         Float
  resourceCompletionRate Float
  updatedSkillEstimate   String
  weakAreasJson          String
  suggestionsJson        String
  recommendedFocusJson   String
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  user                   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmapVersion         RoadmapVersion? @relation(fields: [roadmapVersionId], references: [id], onDelete: SetNull)
}

model PracticeTest {
  id                   String         @id @default(cuid())
  userId               String
  roadmapVersionId     String?
  title                String
  summary              String
  focusLabel           String
  formatPreference     String
  estimatedTotalMinutes Int
  contentJson          String
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmapVersion       RoadmapVersion? @relation(fields: [roadmapVersionId], references: [id], onDelete: SetNull)
  attempts             PracticeTestAttempt[]
}

model PracticeTestAttempt {
  id                   String       @id @default(cuid())
  userId               String
  practiceTestId       String
  answersJson          String
  resultJson           String
  scorePercent         Float
  earnedPoints         Float
  totalPoints          Float
  summary              String
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  practiceTest         PracticeTest @relation(fields: [practiceTestId], references: [id], onDelete: Cascade)
}
